{
  "name": "cocos-challenge-api",
  "version": "0.1.0",
  "private": true,
  "description": "API de portfolio, búsqueda de instrumentos y órdenes",
  "main": "dist/main.js",
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:unit": "npm test -- --selectProjects unit",
    "test:int": "npm test -- --selectProjects integration --runInBand",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "reconcile": "tsx src/reconcile.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:migrate",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts",
    "db:codegen": "kysely-codegen --dialect postgres --url \"env(MIGRATION_DATABASE_URL)\" --exclude-pattern \"kysely_*\" --date-parser string --out-file src/infrastructure/database/schema.ts",
    "db:codegen:check": "npm run db:codegen -- --verify"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv-formats": "^3.0.1",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.8",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.8.0",
    "jest": "^30.5.2",
    "kysely-codegen": "^0.20.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
