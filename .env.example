# Servidor HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Usuario de base de datos de la aplicación (solo DML)
DATABASE_URL=postgres://cocos_app:cocos_app@localhost:5432/cocos

# Usuario de base de datos de las migraciones (DDL)
MIGRATION_DATABASE_URL=postgres://cocos_migrator:cocos_migrator@localhost:5432/cocos

# Ruta de simulación de ejecución de órdenes LIMIT, solo para pruebas
MARKET_SIMULATION_ENABLED=false
